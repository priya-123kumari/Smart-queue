# Copy to .env and export, or set in your shell. Everything is optional.
ANTHROPIC_API_KEY=
SMARTQUEUE_MODEL=claude-opus-5-5
# Free local alternative (Ollama): LLM_BASE_URL=http://localhost:11434 and SMARTQUEUE_MODEL=qwen2.5:3b (no API key needed)
LLM_BASE_URL=
SMARTQUEUE_DB=data/smartqueue.db
SMARTQUEUE_API_KEY=

# High-risk ticket email alerts. Leave SMTP_HOST empty for dry-run (alerts saved, visible at GET /api/alerts).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char App Password>
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
